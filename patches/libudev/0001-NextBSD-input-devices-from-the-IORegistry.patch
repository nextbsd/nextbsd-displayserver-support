+/*
+ * NextBSD: input devices from the IORegistry.
+ *
+ * The kernel publishes every /dev/input/eventN as an IOHIDDevice registry
+ * entry (nextbsd-kernel#331). This file enumerates those entries, turns
+ * their properties into the udev properties libinput and the X server
+ * read, and watches them with IOKit match/terminate notifications.
+ */
+
+#ifndef UDEV_IOKIT_H_
+#define UDEV_IOKIT_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct udev_device;
+struct udev_enumerate;
+
+/* Registry class and the devfs prefix of its nodes. */
+#define	UDEV_IOKIT_HID_CLASS	"IOHIDDevice"
+#define	UDEV_IOKIT_EVDEV_PREFIX	DEV_PATH_ROOT "/input/event"
+
+/*
+ * Add the syspath (= devnode, /dev/input/eventN) of every live IOHIDDevice
+ * entry to `ue`. Returns 1 when the registry answered (the devfs scan then
+ * skips /dev/input/event*), 0 when it is not reachable (no /dev/ioregistry:
+ * the devfs scan finds the nodes as before) and -1 on allocation failure.
+ */
+int	udev_iokit_enumerate(struct udev_enumerate *ue);
+
+/*
+ * Fill an evdev udev_device (syspath /dev/input/eventN) from its registry
+ * entry. Returns false if there is no entry, or if its PrimaryUsage maps to
+ * no ID_INPUT_* type; the caller then classifies the node from the
+ * kern.evdev.input sysctls as libudev-devd always did.
+ */
+bool	udev_iokit_create_evdev(struct udev_device *ud);
+
+/*
+ * Hotplug. The callback runs on a private serial dispatch queue (never on
+ * the caller's thread) with the syspath of an input node that appeared
+ * (UD_ACTION_ADD) or went away (UD_ACTION_REMOVE).
+ */
+typedef void	udev_iokit_event_fn(void *arg, const char *syspath,
+		    int action);
+
+struct udev_iokit_watch;
+
+/*
+ * Start watching IOHIDDevice entries; `fn` gets one call per hotplug event,
+ * serialised. The entries present now are remembered (so that their removal
+ * is reported) but not reported as added: the caller enumerates them.
+ * Returns NULL if the registry is not reachable or on allocation failure.
+ */
+struct udev_iokit_watch *udev_iokit_watch_start(udev_iokit_event_fn *fn,
+	    void *arg);
+
+/*
+ * Stop the watch. No call of `fn` starts after this returns, and one that
+ * was running has finished, so `arg` may be freed at once. The watch's own
+ * memory goes when the last queued notification has drained.
+ */
+void	udev_iokit_watch_stop(struct udev_iokit_watch *w);
+
+#endif /* UDEV_IOKIT_H_ */
